{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/workbox-:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/r/:token"
    },
    {
      "source": "/((?!api/|r/|assets/|favicon\\.|robots\\.txt|sitemap\\.xml|manifest\\.|sw\\.js|workbox-|registerSW\\.|.*\\.(?:js|css|map|png|jpg|jpeg|svg|webp|ico|woff|woff2|ttf|eot|json|xml|txt|webmanifest|html)).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/jobs/latest",
      "permanent": true
    },
    {
      "source": "/jobs-in-vizag",
      "destination": "/jobs",
      "permanent": true
    },
    {
      "source": "/it-jobs-in-vizag",
      "destination": "/jobs/it",
      "permanent": true
    },
    {
      "source": "/fresher-jobs-in-vizag",
      "destination": "/jobs/fresher",
      "permanent": true
    },
    {
      "source": "/part-time-jobs-vizag",
      "destination": "/jobs/part-time",
      "permanent": true
    },
    {
      "source": "/civil-jobs-in-vizag",
      "destination": "/jobs/civil",
      "permanent": true
    },
    {
      "source": "/mechanical-jobs-in-vizag",
      "destination": "/jobs/mechanical",
      "permanent": true
    },
    {
      "source": "/electrical-jobs-in-vizag",
      "destination": "/jobs/electrical",
      "permanent": true
    },
    {
      "source": "/ece-jobs-in-vizag",
      "destination": "/jobs/ece",
      "permanent": true
    },
    {
      "source": "/engineering-jobs-in-vizag",
      "destination": "/jobs/engineering",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.jobsinvizag.in"
        }
      ],
      "destination": "https://jobsinvizag.in/:path*",
      "permanent": true
    }
  ]
}
