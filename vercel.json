{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.|robots\\.txt|sitemap\\.xml|manifest\\.|sw\\.js|workbox-|registerSW\\.|.*\\.(?:js|css|map|png|jpg|jpeg|svg|webp|ico|woff|woff2|ttf|eot|json|xml|txt|webmanifest|html)).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/jobs-in-vizag",
      "destination": "/jobs",
      "permanent": true
    },
    {
      "source": "/it-jobs-in-vizag",
      "destination": "/jobs/it",
      "permanent": true
    },
    {
      "source": "/fresher-jobs-in-vizag",
      "destination": "/jobs/fresher",
      "permanent": true
    },
    {
      "source": "/part-time-jobs-vizag",
      "destination": "/jobs/part-time",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.jobsinvizag.in"
        }
      ],
      "destination": "https://jobsinvizag.in/:path*",
      "permanent": true
    }
  ]
}
