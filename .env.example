VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional override if Edge Functions live on a different host (default: ${VITE_SUPABASE_URL}/functions/v1/fetch-external-jobs)
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1/fetch-external-jobs
VITE_SUPABASE_JOBS_TABLE=jobs
# Production site URL (required for employer email verification redirects on Vercel)
VITE_SITE_URL=https://jobsinvizag.in

# Cloudflare R2 — new student resume uploads (existing Supabase Storage paths still work)
# Create a private R2 bucket, then an R2 API token with Object Read & Write.
# Set these on Vercel (Production + Preview). Also set the same secrets on the
# Supabase Edge Function `resume-share` so /r/{token} share links can serve R2 files.
# R2_ACCOUNT_ID=0f59615002dd650133c2933cead1006f
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=resume
# Optional override (default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://0f59615002dd650133c2933cead1006f.r2.cloudflarestorage.com
#
# Server-only Supabase keys used by /api/resume/* and /api/r/* (not VITE_):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AdSense (optional until you have a publisher id)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Also add the same value in Vercel env for production builds (generates public/ads.txt).
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Feature flags (optional)
# Leave unset — email confirmation is disabled on Supabase (see supabase/config.toml).
# VITE_REQUIRE_EMAIL_CONFIRMATION=true

# YouTube Shorts automation (scripts only — use .env.local for real values)
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REFRESH_TOKEN=from npm run youtube:oauth-setup (YouTube + Drive scopes)
# YOUTUBE_REDIRECT_URI=http://localhost:8765/oauth2callback
# GEMINI_API_KEY=your-gemini-key
# AUTO_YOUTUBE_SHORT_RENDERER=pollinations

# Drive → YouTube Shorts (drop MP4 into a Drive folder; see docs/drive-youtube-shorts.md)
# Use a SEPARATE Drive token from your normal Gmail (Brand Accounts have no Drive).
# GOOGLE_DRIVE_REFRESH_TOKEN=from npm run drive:oauth-setup
# GOOGLE_DRIVE_WATCH_FOLDER_ID=your-drive-folder-id
# AUTO_DRIVE_YT_DRY_RUN=false
# AUTO_DRIVE_YT_MAX_FILES=3
# AUTO_DRIVE_YT_PRIVACY=public
# AUTO_DRIVE_YT_GEMINI_MODEL=gemini-2.5-flash
