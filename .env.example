VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional override if Edge Functions live on a different host (default: ${VITE_SUPABASE_URL}/functions/v1/fetch-external-jobs)
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1/fetch-external-jobs
VITE_SUPABASE_JOBS_TABLE=jobs
# Production site URL (required for employer email verification redirects on Vercel)
VITE_SITE_URL=https://jobsinvizag.in
# Feature flags (optional)
# VITE_REQUIRE_EMAIL_CONFIRMATION=true

# YouTube Shorts automation (scripts only — use .env.local for real values)
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REFRESH_TOKEN=from npm run youtube:oauth-setup
# YOUTUBE_REDIRECT_URI=http://localhost:8765/oauth2callback
# GEMINI_API_KEY=your-gemini-key
# AUTO_YOUTUBE_SHORT_RENDERER=pollinations
