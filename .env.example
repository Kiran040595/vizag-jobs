VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional override if Edge Functions live on a different host (default: ${VITE_SUPABASE_URL}/functions/v1/fetch-external-jobs)
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1/fetch-external-jobs
VITE_SUPABASE_JOBS_TABLE=jobs
# Production site URL (required for employer email verification redirects on Vercel)
VITE_SITE_URL=https://jobsinvizag.in
# Optional public Telegram channel for job alerts (shown on homepage CTA)
# VITE_TELEGRAM_CHANNEL_URL=https://t.me/yourchannel
# Feature flags (optional)
# VITE_REQUIRE_EMAIL_CONFIRMATION=true
